# ExitSigner configuration
# Copy this file to ".env" in the project root and adjust the values.
# All settings can also be provided as real environment variables.

# URL to your Lido Keys API (KAPI) service.
# Required. Default: http://127.0.0.1:3600
KAPI_URL=http://127.0.0.1:3600

# URL to your beacon node.
# Required. Default: http://127.0.0.1:5052
# May be a comma-separated list of endpoints. The first endpoint that passes the
# /eth/v1/node/syncing readiness check is used for signing.
# Example: NODE_URL=http://node-a:5052,http://node-b:5052
NODE_URL=http://127.0.0.1:5052

# Validator Ejector scope: JSON mapping staking module id -> list of operator ids.
# Required (auto-detected for Stereum users from the ejector service yaml).
# Replaces the deprecated OPERATOR_ID / MODULE_ID variables.
# Example for module 5, operators 54 and 55:
EJECTOR_SCOPE={"5":[54,55]}

# Percent (1-100) of the operator's validators to sign exit messages for.
# Optional. Default: 10. Can be overridden per-run with --signpercent.
SIGN_PERCENT=10

# Path to the Validator Ejector "messages" folder.
# Optional - auto-detected for Stereum users.
# The path must contain "validatorejector" and end with "messages".
# Example (Stereum): /opt/stereum/services/<service-id>/data/validatorejector/messages
# Example (local test): /tmp/validatorejector-test/messages
VALIDATOR_EJECTOR_MESSAGE_FOLDER=

# Version of the ethdo binary to download and use for signing.
# Optional. Default: 1.39.0
ETHDO_VERSION=1.39.0
